{
 "company": "Tamarind Global Logistics",
 "roles": {
  "READ_ONLY": {
   "description": "View ledgers, vendors and payments. No changes.",
   "risk": "low",
   "typical_titles": [
    "*"
   ]
  },
  "AP_CLERK": {
   "description": "Enter vendor invoices for payment.",
   "risk": "medium",
   "typical_titles": [
    "Accounts Payable Clerk",
    "Accounts Payable Specialist"
   ]
  },
  "AR_CLERK": {
   "description": "Record customer receipts and credit notes.",
   "risk": "medium",
   "typical_titles": [
    "Accounts Receivable Clerk",
    "AR Specialist",
    "Credit Controller"
   ]
  },
  "VENDOR_ADMIN": {
   "description": "Create vendors and change vendor bank details.",
   "risk": "high",
   "typical_titles": [
    "Procurement Specialist",
    "Procurement Manager",
    "Vendor Master Analyst"
   ]
  },
  "PAYMENT_APPROVER": {
   "description": "Approve vendor payments up to USD 250,000.",
   "risk": "high",
   "typical_titles": [
    "AP Supervisor",
    "Finance Manager",
    "Financial Controller",
    "CFO"
   ]
  },
  "GL_ADMIN": {
   "description": "Post and reverse general-ledger journals.",
   "risk": "high",
   "typical_titles": [
    "GL Accountant",
    "Senior Accountant",
    "Financial Controller"
   ]
  },
  "TREASURY_RELEASE": {
   "description": "Release payment batches to the bank.",
   "risk": "critical",
   "typical_titles": [
    "Treasury Analyst",
    "Treasury Manager",
    "CFO"
   ]
  },
  "AUDITOR": {
   "description": "Read everything, including the audit log.",
   "risk": "low",
   "typical_titles": [
    "Internal Auditor",
    "Audit Manager"
   ]
  }
 },
 "sod_rules": [
  {
   "rule_id": "SOD-01",
   "roles": [
    "VENDOR_ADMIN",
    "PAYMENT_APPROVER"
   ],
   "risk": "Can create a vendor and approve payments to it (fictitious-vendor fraud)."
  },
  {
   "rule_id": "SOD-02",
   "roles": [
    "AP_CLERK",
    "PAYMENT_APPROVER"
   ],
   "risk": "Can enter an invoice and approve its own payment."
  },
  {
   "rule_id": "SOD-03",
   "roles": [
    "GL_ADMIN",
    "TREASURY_RELEASE"
   ],
   "risk": "Can release funds and post the journals that hide them."
  }
 ],
