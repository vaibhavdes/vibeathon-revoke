# Copy to .env and fill in at least one key. Groq alone is enough, and free.
# Groq:     https://console.groq.com/keys
GROQ_API_KEY=
# A second free Groq key from another account doubles the daily quota (GROQ_API_KEY_3 ... also work).
GROQ_API_KEY_2=
# Optional, pay per token (very cheap): Sarvam Token Factory, https://dashboard.sarvam.ai
# Used only when every Groq model is at its limit. Models: sarvam-105b, deepseekv4.1-flash-1017, glm5.3-flash.
SARVAM_API_KEY=
# Optional, also free: a second provider gives the demo its own quota when Groq's daily limit is used up.
# Cerebras: https://cloud.cerebras.ai  (free tier, runs gpt-oss-120b)
CEREBRAS_API_KEY=
# Gemini:   https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional, paid. Add "anthropic" to LLM_PROVIDERS to use it.
ANTHROPIC_API_KEY=

# Order in which providers are tried. On a rate limit the agent moves to the next model.
# When every model is out of quota the agent says so, with the time it is back, instead of waiting.
LLM_PROVIDERS=groq,sarvam,cerebras,gemini
# Longest wait (seconds) for a per-minute limit before giving up with that message.
MAX_WAIT_SECONDS=90
# The day the review runs (pinned so the demo data always tells the same story).
REVIEW_DATE=2026-11-24
